# Copy this file to .env and fill in real values. Never commit .env.
# Create a token at https://github.com/settings/tokens (no scopes needed for
# public repositories).
GITHUB_TOKEN=ghp_replace_me

# GitHub OAuth app (https://github.com/settings/developers -> New OAuth App).
# Homepage URL: http://localhost:8000
# Authorization callback URL: http://localhost:8000/auth/callback
GITHUB_OAUTH_CLIENT_ID=replace_me
GITHUB_OAUTH_CLIENT_SECRET=replace_me

# Secret used to sign login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me

# LLM providers (only needed for the AI features).
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=replace_me
EMBEDDING_PROVIDER=hash   # or "openai" (needs OPENAI_API_KEY)
ADMIN_LOGINS=your-github-login   # comma-separated; who may view /admin/metrics
